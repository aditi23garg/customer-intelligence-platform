# ── Streamlit Frontend Image ──────────────────────────────────────────────────
# Lightweight image — no ML deps needed; backend runs on Azure Container Apps
FROM python:3.11-slim

# ── Working directory ─────────────────────────────────────────────────────────
WORKDIR /app

# ── System dependencies (curl needed for HEALTHCHECK) ─────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# ── Install only what the frontend needs ──────────────────────────────────────
RUN pip install --no-cache-dir streamlit==1.35.0 requests==2.31.0

# ── Copy only the Streamlit app ───────────────────────────────────────────────
COPY app/streamlit_app.py ./streamlit_app.py

# ── Streamlit configuration ───────────────────────────────────────────────────
COPY .streamlit/ ./.streamlit/

# ── Expose Streamlit default port ─────────────────────────────────────────────
EXPOSE 8501

# ── Health check ─────────────────────────────────────────────────────────────
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
  CMD curl -f http://localhost:8501/_stcore/health || exit 1

# ── Launch ────────────────────────────────────────────────────────────────────
CMD ["streamlit", "run", "streamlit_app.py", \
     "--server.port=8501", \
     "--server.address=0.0.0.0", \
     "--server.headless=true", \
     "--browser.gatherUsageStats=false"]
